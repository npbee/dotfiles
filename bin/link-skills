#!/usr/bin/env bash
# Link each skill directory in config/agents/skills into ~/.claude/skills.
# A skill is a `<name>/` directory that holds SKILL.md.
set -euo pipefail

src="${DOTFILES:-$HOME/.dotfiles}/config/agents/skills"
dest="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills"

[ -d "$src" ] || { echo "no skills directory: $src" >&2; exit 1; }
mkdir -p "$dest"

shopt -s nullglob
for skill in "$src"/*/; do
  name="$(basename "$skill")"
  path="$dest/$name"
  if [ -L "$path" ] && [ "$(readlink "$path")" = "${skill%/}" ]; then
    echo "ok      $name"
  elif [ -e "$path" ] && [ ! -L "$path" ]; then
    echo "skip    $name (not a symlink)" >&2
  else
    ln -sfn "${skill%/}" "$path"
    echo "linked  $name"
  fi
done

# Drop links whose source is gone.
for path in "$dest"/*; do
  if [ -L "$path" ] && [ ! -e "$path" ]; then
    rm "$path"
    echo "pruned  $(basename "$path")"
  fi
done
