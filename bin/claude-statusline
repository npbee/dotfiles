#!/usr/bin/env bash
# Claude Code statusline:
#   <directory> | <git branch> | <model> | <tokens>/<window> (<percent>) | 5h <n>% · 7d <n>% | <cost>
#
# Wired up via ~/.claude/settings.json:
#   { "statusLine": { "type": "command", "command": "$HOME/.bin/claude-statusline" } }
#
# Reads the session payload Claude Code writes to stdin, then derives:
#   - directory: basename of the workspace dir
#   - git branch: from `git -C <dir>` so it works in worktrees
#   - model: display name, minus any "(1M context)" suffix the window already shows
#   - tokens: input + cache_read + cache_creation from context_window.current_usage
#     (= effective context use); shown as "–" until the first API response
#   - limits: 5-hour and 7-day subscription usage from rate_limits; only sent
#     for Pro/Max after the first API response, so each window may be absent
#   - cost: Claude Code's client-side estimate at list prices, not billed spend

set -u

DEFAULT_WINDOW=${CLAUDE_STATUSLINE_CONTEXT_MAX:-200000}

# Pulls every field out of the payload in one pass. Output is joined by US
# (\x1f) rather than tab, since IFS whitespace would collapse empty fields.
read -r -d '' JQ_FIELDS <<'JQ'
def model_name:
  if type == "object" then (.display_name // .id // "")
  elif type == "string" then .
  else "" end
  | sub(" \\([^)]*context\\)$"; "");

def context_tokens:
  if type == "object" then
    (.input_tokens // 0) + (.cache_read_input_tokens // 0) + (.cache_creation_input_tokens // 0)
  elif type == "number" then .
  else "" end;

def whole_percent: if type == "number" then floor else "" end;

[
  (.workspace.current_dir // .cwd // ""),
  (.model | model_name),
  (.context_window.context_window_size // ""),
  (.context_window.current_usage | context_tokens),
  (.context_window.used_percentage | whole_percent),
  (.rate_limits.five_hour.used_percentage | whole_percent),
  (.rate_limits.seven_day.used_percentage | whole_percent),
  (.cost.total_cost_usd // "")
]
| map(tostring)
| join("\u001f")
JQ

# "~" for $HOME, otherwise the directory's basename.
short_dir() {
  [[ -z $1 ]] && return
  if [[ $1 == "$HOME" ]]; then echo "~"; else basename "$1"; fi
}

# Branch name, or short SHA when detached.
git_branch() {
  [[ -d $1 ]] || return
  git -C "$1" symbolic-ref --quiet --short HEAD 2>/dev/null ||
    git -C "$1" rev-parse --short HEAD 2>/dev/null
}

# 950, 1.2k, 127k, 1M, 1.5M
fmt_tokens() {
  local n=$1
  if ((n < 1000)); then
    printf '%d' "$n"
  elif ((n < 10000)); then
    printf '%d.%dk' $((n / 1000)) $((n / 100 % 10))
  elif ((n < 1000000)); then
    printf '%dk' $((n / 1000))
  elif ((n / 100000 % 10 == 0)); then
    printf '%dM' $((n / 1000000))
  else
    printf '%d.%dM' $((n / 1000000)) $((n / 100000 % 10))
  fi
}

# $3.46 under $10, $42.3 above.
fmt_cost() {
  [[ -z $1 ]] && return
  awk -v c="$1" 'BEGIN { printf (c < 10 ? "$%.2f" : "$%.1f"), c }'
}

# Green under 50%, yellow under 80%, red above. Plain text when NO_COLOR is set.
colorize_by_percent() {
  local text=$1 percent=${2:-0} color
  if [[ -n ${NO_COLOR:-} ]]; then
    printf '%s' "$text"
    return
  fi
  if ((percent >= 80)); then
    color=31
  elif ((percent >= 50)); then
    color=33
  else
    color=32
  fi
  printf '\033[%sm%s\033[0m' "$color" "$text"
}

# "127k/1M (12%)", or "–/1M" before the first API response. The payload's
# used_percentage is only trusted alongside current_usage so both numbers come
# from the same snapshot.
token_field() {
  local tokens=$1 window=$2 percent=$3
  if [[ -z $tokens ]]; then
    colorize_by_percent "–/$(fmt_tokens "$window")"
    return
  fi
  if [[ -z $percent ]] && ((window > 0)); then
    percent=$((tokens * 100 / window))
  fi
  colorize_by_percent "$(fmt_tokens "$tokens")/$(fmt_tokens "$window") (${percent:-0}%)" "$percent"
}

# "5h 42% · 7d 18%", each colored by its own usage; empty when neither is sent.
limits_field() {
  local five_hour=$1 seven_day=$2 limits=()
  [[ -n $five_hour ]] && limits+=("$(colorize_by_percent "5h ${five_hour}%" "$five_hour")")
  [[ -n $seven_day ]] && limits+=("$(colorize_by_percent "7d ${seven_day}%" "$seven_day")")
  ((${#limits[@]})) || return
  local joined
  printf -v joined ' · %s' "${limits[@]}"
  printf '%s' "${joined# · }"
}

IFS=$'\x1f' read -r cwd model window tokens percent five_hour seven_day cost \
  < <(jq -r "$JQ_FIELDS" 2>/dev/null)

parts=(
  "$(short_dir "${cwd:-}")"
  "$(git_branch "${cwd:-}")"
  "${model:-}"
  "$(token_field "${tokens:-}" "${window:-$DEFAULT_WINDOW}" "${percent:-}")"
  "$(limits_field "${five_hour:-}" "${seven_day:-}")"
  "$(fmt_cost "${cost:-}")"
)

out=""
for p in "${parts[@]}"; do
  [[ -n $p ]] && out+=" | $p"
done
printf '%s' "${out# | }"
